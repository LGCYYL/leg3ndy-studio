{
  "name": "leg3ndy-studio",
  "version": "1.3.2",
  "description": "LEG3NDY Downloader Studio",
  "main": "main.js",
  "author": "LEG3NDY Tech",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron:ts\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron:ts": "tsc -p tsconfig.electron.json --watch --preserveWatchOutput",
    "dev:electron": "wait-on tcp:5173 file:main.js file:preload.js && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "start": "npm run build && electron .",
    "build": "npm run build:electron && npm run build:renderer",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:renderer": "vite build",
    "dist": "npm run build && npm run prepare:runtime && electron-builder",
    "generate:icons": "powershell -ExecutionPolicy Bypass -File scripts/generate-icons.ps1",
    "prepare:runtime": "node scripts/prepare-runtime.mjs",
    "dist:win": "npm run build && npm run prepare:runtime && electron-builder --win nsis",
    "dist:mac": "npm run build && npm run prepare:runtime && electron-builder --mac dmg zip",
    "release:win": "electron-builder --win nsis",
    "release:mac": "electron-builder --mac dmg zip"
  },
  "dependencies": {
    "cross-env": "^7.0.3",
    "electron-updater": "^6.3.9",
    "hls.js": "^1.6.15",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "@emnapi/core": "1.9.1",
    "@emnapi/runtime": "1.9.1",
    "@types/node": "^20.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "electron": "^33.2.0",
    "electron-builder": "^24.13.3",
    "typescript": "^5.0.0",
    "vite": "^8.0.3",
    "wait-on": "^9.0.4"
  },
  "build": {
    "appId": "com.leg3ndy.studio",
    "productName": "LEG3NDY Studio",
    "publish": [
      {
        "provider": "github",
        "owner": "LGCYYL",
        "repo": "leg3ndy-studio"
      }
    ],
    "directories": {
      "output": "dist_electron"
    },
    "win": {
      "target": "nsis",
      "icon": "public/icons/icon.ico",
      "requestedExecutionLevel": "asInvoker",
      "legalTrademarks": "LEG3NDY"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LEG3NDY Studio",
      "include": "resources_build/installer.nsh",
      "displayLanguageSelector": true,
      "runAfterFinish": true
    },
    "files": [
      "**/*",
      "!backend/**",
      "!dist/**",
      "!build/**",
      "!resources_build/**",
      "!frontend/src/**",
      "!frontend/script.js",
      "!frontend/script.ts",
      "!*.py",
      "!*.spec"
    ],
    "extraResources": [
      {
        "from": "resources_build",
        "to": "engine",
        "filter": [
          "leg3ndy-engine*",
          "ffmpeg*",
          "node*",
          "bgutil-server/**/*"
        ]
      },
      {
        "from": "public/icons",
        "to": "public/icons"
      }
    ],
    "mac": {
      "icon": "public/icons/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities"
    },
    "linux": {
      "icon": "public/icons"
    },
    "afterSign": "scripts/notarize.mjs"
  }
}
